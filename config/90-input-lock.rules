// Only the daemon may suppress logind lid-switch handling. It can no longer
// request blocking sleep inhibition; no interactive root helper is needed.
polkit.addRule(function(action, subject) {
    if (subject.user === "input-lockd" &&
        action.id === "org.freedesktop.login1.inhibit-handle-lid-switch") {
        return polkit.Result.YES;
    }
});

// A "delay" sleep lock only: logind waits (at most InhibitDelayMaxSec) until
// the daemon has extended its watchdog for the sleep, then proceeds. It can
// never block a suspend; "block" sleep inhibition stays unavailable.
polkit.addRule(function(action, subject) {
    if (subject.user === "input-lockd" &&
        action.id === "org.freedesktop.login1.inhibit-delay-sleep") {
        return polkit.Result.YES;
    }
});

// Only this fixed AAG - InputLock adapter may be started; no general unit management.
polkit.addRule(function(action, subject) {
    if (subject.user === "input-lockd" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "input-lock-protect.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
