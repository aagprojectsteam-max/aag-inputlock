#: src/input_lock_cli.py:148
#, python-brace-format
msgid "input-lock: warning: the running daemon reports protocol {reported}; this CLI uses protocol {protocol}. Restart {unit} after an update."
msgstr "⁨input-lock⁩: אזהרה: שירות הרקע הפועל מדווח על פרוטוקול ⁨{reported}⁩; שורת הפקודה משתמשת בפרוטוקול ⁨{protocol}⁩. יש להפעיל מחדש את ⁨{unit}⁩ לאחר עדכון."

