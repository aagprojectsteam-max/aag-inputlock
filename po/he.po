#: src/input_lock_cli.py:80
#, python-brace-format
msgid "input-lock: configuration cannot be parsed ({error}); using the default socket {path}"
msgstr "input-lock: לא ניתן לקרוא את קובץ ההגדרות ({error}); נעשה שימוש בשקע ברירת המחדל ‎{path}"

#: src/input_lock_cli.py:125
#, python-brace-format
msgid "cannot connect to the Input Lock daemon at {path} ({error}; {unit} is {state}). Check: systemctl status {unit}"
msgstr ""
"אין חיבור לשירות הרקע של נעילת הקלט בכתובת ‎{path} ({error}; מצב {unit}: ⁨{state}⁩). לבדיקה:\n"
"systemctl status {unit}"

#: src/input_lock_cli.py:148
#, python-brace-format
msgid "input-lock: warning: the running daemon does not report a protocol version (it is probably older than this CLI); this CLI uses protocol {protocol}. Restart {unit} after an update."
msgstr "input-lock: אזהרה: שירות הרקע הפועל אינו מדווח על גרסת פרוטוקול (כנראה שהוא ישן יותר משורת הפקודה הזו); שורת הפקודה משתמשת בפרוטוקול ⁨{protocol}⁩. יש להפעיל מחדש את {unit} לאחר עדכון."

#: src/input_lock_cli.py:152
#, python-brace-format
msgid "input-lock: warning: the running daemon reports protocol {reported}; this CLI uses protocol {protocol}. Restart {unit} after an update."
msgstr "input-lock: אזהרה: שירות הרקע הפועל מדווח על פרוטוקול ⁨{reported}⁩; שורת הפקודה משתמשת בפרוטוקול ⁨{protocol}⁩. יש להפעיל מחדש את {unit} לאחר עדכון."

