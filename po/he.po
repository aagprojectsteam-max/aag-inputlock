#: src/input_lock_cli.py:76
#, python-brace-format
msgid "input-lock: configuration cannot be parsed ({error}); using the default socket {path}"
msgstr "⁨input-lock⁩: לא ניתן לקרוא את קובץ ההגדרות (⁨{error}⁩); נעשה שימוש בשקע ברירת המחדל ⁨{path}⁩"

