msgid "Locked"
msgstr "נעול"

#: src/input_lock_cli.py:182
msgid "Unlocked"
msgstr "לא נעול"

#: src/input_lock_cli.py:187 src/input_lock_messages.py:199
msgid "review 'journalctl -u input-lock-failsafe.service', then run: sudo /usr/bin/python3 /usr/lib/input-lock/input_lock_safety.py acknowledge-failure"
msgstr ""
"יש לעיין בפלט של הפקודה:\n"
"journalctl -u input-lock-failsafe.service\n"
"ולאחר מכן להריץ:\n"
"sudo /usr/bin/python3 /usr/lib/input-lock/input_lock_safety.py acknowledge-failure"

