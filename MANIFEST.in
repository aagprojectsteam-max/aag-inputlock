include VERSION README.md install.sh update.sh uninstall.sh
include src/input-lock src/input-lock-daemon src/input-lock-notifier src/input-lock-power-helper src/input-lock-launch
recursive-include assets *.svg *.png *.desktop
recursive-include config *.conf *.rules
recursive-include systemd *.service
recursive-include integration input-lock-system-sleep
recursive-include gnome-extension *.js *.json
recursive-include docs *.md
recursive-include tests *.py *.sh
recursive-include tools *.py
recursive-include windows *.ps1 *.spec *.md
recursive-include .github *.yml
global-exclude *.py[cod] *.log
prune windows/out
prune windows/build
