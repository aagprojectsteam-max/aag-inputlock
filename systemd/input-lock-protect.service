[Unit]
Description=AAG - InputLock ordinary suspend protection
OnFailure=input-lock-failsafe.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/input-lock/input_lock_safety.py protect
# observe_suspend() budget (240 s) + at least 60 s for the steps before it.
TimeoutStartSec=330s
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
# "-": a missing /var/lib/input-lock (fresh install, uninstall) must not fail
# the unit with 226/NAMESPACE before the helper can run (S-R8c).
ReadWritePaths=-/var/lib/input-lock
StateDirectory=input-lock-protection
StateDirectoryMode=0755
ProtectHome=yes
PrivateTmp=yes
# Reads /sys (thermal, power_supply, suspend_stats) and /proc (lid, boot_id)
# read-only; talks to logind and systemd only over AF_UNIX D-Bus/systemctl.
# Deliberately no CapabilityBoundingSet= (lead decision 2026-10-22): a narrow
# bounding set cannot be verified without a real protective suspend, and a
# wrong one would silently break this last-resort safety path. Root keeps its
# default capabilities (for example DAC override to write the receipt copy
# into input-lockd's 0700 state directory).
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
