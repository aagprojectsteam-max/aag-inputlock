[Unit]
Description=InputLock final ordinary suspend recovery after releasing input
After=input-lock.service input-lock-protect.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/input-lock/input_lock_safety.py recover
ExecStopPost=/usr/bin/python3 /usr/lib/input-lock/input_lock_safety.py record-failure
# Stop the daemon (10 s) + observe_suspend() budget (240 s) + margin.
TimeoutStartSec=330s
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/input-lock
StateDirectory=input-lock-protection
StateDirectoryMode=0755
ProtectHome=yes
PrivateTmp=yes
# Same sandbox as input-lock-protect.service: read-only /sys and /proc,
# systemctl and logind over AF_UNIX only, no device nodes.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_BOOT
RestrictAddressFamilies=AF_UNIX
