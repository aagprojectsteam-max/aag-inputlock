[Unit]
Description=AAG - InputLock evdev daemon
Documentation=file:/usr/share/doc/input-lock/README.md
After=systemd-udevd.service systemd-user-sessions.service upower.service
Wants=systemd-udevd.service upower.service
OnFailure=input-lock-failsafe.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
# The daemon sends READY=1 once its socket exists and the first state file is
# written, so "systemctl start/restart" returns only when the CLI can connect.
Type=notify
NotifyAccess=main
User=input-lockd
Group=input-lockd
SupplementaryGroups=input
# A previous session may have ended while the temporary UPower override was
# active.  Remove it as root before the unprivileged daemon starts.
ExecStartPre=+/usr/lib/input-lock/input-lock-power-helper disable
ExecStart=/usr/lib/input-lock/input-lock-daemon
# ExecStopPost runs under TimeoutStopSec=5s, so a UPower restart (legacy
# drop-in only) is enqueued with --no-block and verified by the next
# ExecStartPre, which waits.
ExecStopPost=+/usr/lib/input-lock/input-lock-power-helper disable --no-block
LimitNOFILE=512
ExecReload=/bin/kill -HUP $MAINPID
# 60 s: longer than one 20 s kernel freezer timeout, so a single freeze outside
# a sleep window is not fatal. From PrepareForSleep(true) the daemon raises its
# own watchdog to 300 s with sd_notify WATCHDOG_USEC (one suspend may make
# several failing 20 s freeze attempts) and restores 60 s only once logind no
# longer reports PreparingForSleep (or, if that is unknown, at the window cap).
WatchdogSec=60s
Restart=no
RestartSec=2s
TimeoutStopSec=5s
RuntimeDirectory=input-lock
RuntimeDirectoryMode=0755
StateDirectory=input-lock
StateDirectoryMode=0700
UMask=0077

# The daemon needs the host /dev/input nodes and libudev's netlink socket.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Hardening. No network stack, writable home, module access, or new privilege.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
